# Maintainer: pch <https://github.com/pch>
pkgname=omafeed
pkgver=0.1.0
pkgrel=1
pkgdesc='A native Rust RSS reader for Linux and Omarchy'
arch=('x86_64' 'aarch64')
url='https://github.com/pch/omafeed'
license=('MIT')
depends=('gcc-libs' 'glibc' 'gtk4' 'libadwaita' 'webkitgtk-6.0')
makedepends=('cargo' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz::https://github.com/pch/omafeed/archive/refs/tags/v$pkgver.tar.gz")
# The release workflow publishes this file with the real checksum filled in.
sha256sums=('SKIP')

prepare() {
  cd "omafeed-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "omafeed-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "omafeed-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen --workspace
}

package() {
  cd "omafeed-$pkgver"
  make install DESTDIR="$pkgdir" PREFIX=/usr
}
