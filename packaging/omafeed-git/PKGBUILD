# Maintainer: pch <https://github.com/pch>
pkgname=omafeed-git
pkgver=0.1.0
pkgrel=1
pkgdesc='A native Rust RSS reader for Linux and Omarchy (development version)'
arch=('x86_64' 'aarch64')
url='https://github.com/pch/omafeed'
license=('MIT')
depends=('glib2' 'glibc' 'gtk4' 'hicolor-icon-theme' 'libadwaita' 'libgcc' 'webkitgtk-6.0')
makedepends=('cargo' 'git' 'pkgconf')
# makepkg's LTO flags turn bundled C code (SQLite, ring) into GCC bytecode rustc
# cannot link; the release profile already strips, so a debug package would be empty.
options=('!lto' '!debug')
provides=('omafeed')
conflicts=('omafeed')
source=('omafeed::git+https://github.com/pch/omafeed.git')
sha256sums=('SKIP')

pkgver() {
  cd omafeed
  local version
  version=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n1)
  printf '%s.r%s.%s' "$version" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd omafeed
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd omafeed
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd omafeed
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen --workspace
}

package() {
  cd omafeed
  make install DESTDIR="$pkgdir" PREFIX=/usr PKGNAME="$pkgname"
}
